<Window x:Class="OpticalDataDiode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpticalDataDiode.Views"
        Title="망분리 단방향 광학 클립보드 전송기 (Optical Data Diode)" 
        Height="780" Width="1020" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 내비게이션 바 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="⚡ Optical Data Diode" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Air-Gap PPT Clipboard" FontSize="11" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- 탭 전환 버튼 -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <RadioButton x:Name="TabSender" Content="📤 송신 모드 (Sender)" Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="15,8" Margin="0,0,10,0" IsChecked="True" FontWeight="SemiBold"
                                 Checked="TabMode_Checked" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                    <RadioButton x:Name="TabReceiver" Content="📥 수신 모드 (Receiver)" Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="15,8" FontWeight="SemiBold"
                                 Checked="TabMode_Checked" Background="#334155" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 뷰 전환 영역 -->
        <Grid Grid.Row="1">
            <views:SenderView x:Name="ViewSender" Visibility="Visible"/>
            <views:ReceiverView x:Name="ViewReceiver" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
