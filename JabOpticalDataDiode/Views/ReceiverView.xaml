<UserControl x:Class="JabOpticalDataDiode.Views.ReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="920" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 컨트롤 및 수신 통계 -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="JAB Code 수신 컨트롤러" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,5,5"/>
                <TextBlock Text="Warp Rectification &amp; Color Calibrated" FontSize="12" Foreground="#8B5CF6" FontWeight="SemiBold" Margin="0,0,0,15"/>

                <TextBlock Text="웹캠 디바이스 선택" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCameras" SelectedIndex="0" Height="35" Margin="0,0,0,15">
                    <ComboBoxItem Content="기본 웹캠 (Camera 0)"/>
                    <ComboBoxItem Content="보조 웹캠 (Camera 1)"/>
                    <ComboBoxItem Content="외부 웹캠 (Camera 2)"/>
                </ComboBox>

                <Button x:Name="BtnToggleCamera" Content="📷 웹캠 스캔 시작" Height="45"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="14"
                        Click="BtnToggleCamera_Click" Margin="0,0,0,20"/>

                <Separator Margin="0,0,0,15"/>

                <TextBlock Text="실시간 FEC 복원 상태" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="현재 세션 ID" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtSessionId" Text="대기 중..." FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="수신된 유효 랭크 / 필요 블록 (K)" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtRankProgress" Text="0 / 0" FontSize="16" FontWeight="Bold" Foreground="#7C3AED"/>
                </StackPanel>

                <TextBlock Text="진행률" FontSize="12" Foreground="#64748B" Margin="0,5,0,2"/>
                <ProgressBar x:Name="PrgProgress" Height="15" Minimum="0" Maximum="100" Value="0" 
                             Foreground="#10B981" Background="#E2E8F0" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="초당 인식 프레임 (Scan FPS)" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtScanFps" Text="0 FPS" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                </StackPanel>

                <Border x:Name="BoxNotice" Background="#F5F3FF" CornerRadius="8" Padding="12" Margin="0,15,0,0"
                        BorderBrush="#DDD6FE" BorderThickness="1">
                    <TextBlock x:Name="TxtStatus" Text="송신 화면의 JAB Code를 비춰주세요." FontSize="13" 
                               Foreground="#5B21B6" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 우측: 웹캠 실시간 프리뷰 화면 -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="카메라 실시간 피드 (왜곡 보정 &amp; 컬러 트래킹)" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" ClipToBounds="True">
                    <Image x:Name="CamPreviewImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
