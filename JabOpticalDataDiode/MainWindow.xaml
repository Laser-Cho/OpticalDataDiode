<Window x:Class="JabOpticalDataDiode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JabOpticalDataDiode.Views"
        Title="망분리 8-Color JAB Code 광학 클립보드 전송기 (JAB Optical Data Diode)" 
        Height="780" Width="1040" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 내비게이션 바 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🌈 JAB Optical Data Diode" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#6D28D9" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Polychrome 2D Matrix" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- 탭 전환 버튼 -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <RadioButton x:Name="TabSender" Content="📤 송신 모드 (Sender)" Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="16,8" Margin="0,0,10,0" IsChecked="True" FontWeight="SemiBold"
                                 Checked="TabMode_Checked" Background="#7C3AED" Foreground="White" BorderThickness="0"/>
                    <RadioButton x:Name="TabReceiver" Content="📥 수신 모드 (Receiver)" Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="16,8" FontWeight="SemiBold"
                                 Checked="TabMode_Checked" Background="#334155" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 뷰 영역 -->
        <Grid Grid.Row="1">
            <views:SenderView x:Name="ViewSender" Visibility="Visible"/>
            <views:ReceiverView x:Name="ViewReceiver" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
